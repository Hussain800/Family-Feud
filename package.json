{
  "name": "gdg-family-feud",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:sdk": "pnpm exec air-jam-server dev",
    "build": "tsc && vite build",
    "build:lan": "node scripts/dev.mjs build",
    "start": "node scripts/dev.mjs preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "probe": "node scripts/probe-airjam.mjs",
    "e2e": "node scripts/e2e-match.mjs",
    "lint": "eslint src tests scripts",
    "status": "pnpm exec air-jam-server status",
    "e2e:failures": "node scripts/e2e-failures.mjs",
    "e2e:drop": "node scripts/e2e-phone-drop.mjs",
    "e2e:faceoff": "node scripts/e2e-faceoff.mjs"
  },
  "dependencies": {
    "@air-jam/sdk": "^0.9.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@air-jam/server": "^0.9.2",
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright-core": "^1.63.0",
    "socket.io-client": "4.8.4",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.46.4",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
